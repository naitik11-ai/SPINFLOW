# ===================================================================
# SpinFlow - Production Deployment Environment Variables Template
# ===================================================================

# 1. Supabase Cloud Database (PostgreSQL & Realtime Sync)
# Create a free project at https://supabase.com and copy the API keys from Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Hostel Administrator Phone Numbers (Comma-separated 10-digit Indian numbers)
# Only these phone numbers can receive Admin OTP and access the Usage Analytics Dashboard
VITE_ADMIN_PHONE_NUMBERS=9876543210,9999999999

# 3. SMS Gateway Configuration (Optional - for live SMS OTP dispatch)
# Provider options: fast2sms | webhook | demo
VITE_SMS_PROVIDER=demo
VITE_SMS_API_KEY=
VITE_SMS_SENDER_ID=SPNFLW
VITE_SMS_WEBHOOK_URL=
